---
import Base from '../layouts/Base.astro';
import community from '../data/community.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/nanbo0ne/O.R.C.A-for-Windows';
const R2 = 'https://orca.aichat.diy/releases/desktop-v3.0.3';

const goVer = '3.0.3';

const fmtN = (n) => Number(n).toLocaleString('en-US');
const avClass = (i) => 'av' + (i % 5 === 2 ? ' sm' : i % 7 === 3 ? ' lg' : '');
const half = Math.ceil(community.list.length / 2);
const rowA = community.list.slice(0, half);
const rowB = community.list.slice(half);

const desc = "Open Reasoning & Computing Agent: a workspace for coding, everyday work, Vision attachments, and optional local AI. Computer Use is temporarily disabled on all platforms in 3.0.3.";
const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'O.R.C.A.',
  description: desc,
  url: repo,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Windows, Linux',
  softwareVersion: goVer,
  license: `${repo}/blob/main-v2/LICENSE`,
  downloadUrl: `${repo}/releases`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<Base
  title="O.R.C.A — Open Reasoning & Computing Agent"
  titleEn="O.R.C.A — Open Reasoning & Computing Agent"
  titleZh="O.R.C.A — 开放推理与计算智能体"
  description={desc}>

  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" is:inline />

  <header class="nav">
    <div class="nav-inner">
      <a class="brand" href={`${base}/`}><img src={`${base}/logo.svg`} alt="O.R.C.A logo" /><span>O.R.C.A</span></a>
      <nav class="nav-links">
        <a href="#features"><span class="l-en">Features</span><span class="l-zh">特性</span></a>
        <a href="#how"><span class="l-en">How it works</span><span class="l-zh">工作原理</span></a>
        <a href="#community"><span class="l-en">Community</span><span class="l-zh">社区</span></a>
        <a href={`${base}/docs/`}><span class="l-en">Docs</span><span class="l-zh">文档</span></a>
        <a href="#start"><span class="l-en">Get started</span><span class="l-zh">快速开始</span></a>
      </nav>
      <div class="lang-switch" role="group" aria-label="Language">
        <button type="button" data-lang="en" class="active">EN</button>
        <button type="button" data-lang="zh">中文</button>
      </div>
      <a class="btn btn-dark" href="#start"><span class="l-en">Install</span><span class="l-zh">安装</span></a>
    </div>
  </header>

  <main>
  <section class="hero">
    <canvas class="hero-dots"></canvas>
    <div class="wrap">
      <div class="eyebrow reveal"><span class="dot"></span><span class="l-en">Cloud or local · Vision attachments · MIT</span><span class="l-zh">云端或本地 · Vision 附件识图 · MIT</span></div>
      <h1 class="reveal" style="--d:0.06s">
        <span class="l-en"><span class="grad">Open Reasoning</span><br />& Computing Agent.</span>
        <span class="l-zh"><span class="grad">开放推理</span>与<br />计算智能体。</span>
      </h1>
      <p class="sub reveal" style="--d:0.12s">
        <span class="l-en">Choose cloud providers or a managed local Qwen model, then use O.R.C.A to code, research, analyze images you attach, and create work artifacts.</span>
        <span class="l-zh">自由选择云端供应商或由 O.R.C.A 管理的本地 Qwen，使用它编程、调研、分析你附上的图片和制作办公产物。</span>
      </p>
      <p class="reveal"><span class="l-en">3.0.3 temporarily disables Computer Use on Windows, macOS, and Linux: no computer-control tools, screen captures, or native input. Code and configuration remain for restoration after later validation. Ordinary attachments and default Vision remain supported.</span><span class="l-zh">3.0.3 在 Windows、macOS、Linux 所有平台暂时禁用电脑操控，不注册电脑工具、不截图、不执行原生输入。代码和配置保留，待后续验收后恢复；普通附件和默认 Vision 识图仍支持。</span></p>
      <div class="hero-cta reveal" style="--d:0.18s">
        <a class="btn btn-dark" data-os-dl data-goto="desktop" href="#start"><span class="l-en">Download for <span class="os-name">macOS</span></span><span class="l-zh">下载 <span class="os-name">macOS</span> 版</span></a>
        <span class="install"><span class="ps1">$</span>npm i -g orca-agent<button data-copy="npm i -g orca-agent">Copy</button></span>
        <a class="btn btn-ghost" href="#how"><span class="l-en">How it works ↓</span><span class="l-zh">工作原理 ↓</span></a>
      </div>
      <div class="also reveal" style="--d:0.22s"><span class="l-en">Also via <a href="#start" data-goto="brew">Homebrew</a> and <a href="#start" data-goto="desktop">desktop apps</a> · macOS / Windows / Linux</span><span class="l-zh">也可通过 <a href="#start" data-goto="brew">Homebrew</a> 与<a href="#start" data-goto="desktop">桌面端</a>安装 · macOS / Windows / Linux</span></div>

      <div class="term-stage reveal" style="--d:0.26s">
        <div class="fig"><span class="l-en">fig. 01 — a live session, cache still warm</span><span class="l-zh">图 01 —— 一场实时会话,缓存依然温热</span></div>
        <div class="term">
          <div class="term-bar"><i></i><i></i><i></i><span class="title">~/app — orca chat</span></div>
          <div class="term-body"><span class="tl"><span class="t-acc">◆</span> orca <span class="t-dim">v<span class="rxv">{goVer}</span> · qwen3.8-27b · ~/app</span></span><span class="tl"><span class="t-vio">›</span> add retry with backoff to the http client</span><span class="tl"><span class="t-ok">✓</span> edit <span class="t-dim">internal/net/client.go</span>  <span class="t-add">+24 −3</span></span><span class="tl"><span class="t-ok">✓</span> edit <span class="t-dim">internal/net/client_test.go</span>  <span class="t-add">+41 −0</span></span><span class="tl"><span class="t-ok">✓</span> run <span class="t-dim">go test ./internal/net/</span>  <span class="t-ok">ok</span> <span class="t-dim">(0.21s)</span></span><span class="tl"><span class="t-warm">●</span> <span class="t-dim">provider · local · work tools</span></span><span class="tl"><span class="t-vio">›</span> <span class="caret"></span></span></div>
          <div class="term-stat"><span>cache <b data-cnt="95.1" data-dec="1" data-suf="% hit">95.1% hit</b></span><span>session <b data-cnt="18" data-suf="m">18m</b></span><span>model <b>deepseek-v4-flash</b></span><span>cost <b data-cnt="0.043" data-dec="3" data-pre="$">$0.043</b></span></div>
        </div>
      </div>
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <div class="sec-head split reveal">
        <span class="kicker"><span class="l-en">Features</span><span class="l-zh">特性</span></span>
        <h2><span class="l-en">Built for long, <span class="em">cheap</span> sessions.</span><span class="l-zh">为长会话、<span class="em">低成本</span>而生。</span></h2>
        <p><span class="l-en">O.R.C.A keeps stable prompt prefixes cache-friendly across supported providers while separating Coding, Assistant, and Orca session contexts.</span><span class="l-zh">O.R.C.A 在支持的供应商之间保持缓存友好的稳定提示词前缀，并隔离编程、助手与 Orca 会话上下文。</span></p>
      </div>
      <div class="feat-grid">
        <div class="feat reveal">
          <span class="tag">01 / cache-first</span>
          <h3><span class="l-en">Cache-first loop</span><span class="l-zh">缓存优先循环</span></h3>
          <p><span class="l-en">Append-only history and stable prefixes preserve provider cache reuse without tying the product to one model family.</span><span class="l-zh">append-only 历史与稳定前缀复用供应商缓存，同时不再绑定单一模型家族。</span></p>
          <div class="feat-viz" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i class="n"></i><i class="n"></i><i class="n"></i></div>
        </div>
        <div class="feat reveal" style="--d:0.06s">
          <span class="tag">02 / single binary</span>
          <h3><span class="l-en">Single Go binary</span><span class="l-zh">单个 Go 二进制</span></h3>
          <p><span class="l-en">CGO-free, cross-compiled for darwin/linux/windows × amd64/arm64. No Node runtime to install or babysit.</span><span class="l-zh">无 CGO,交叉编译覆盖 darwin/linux/windows × amd64/arm64。运行不需要 Node。</span></p>
        </div>
        <div class="feat reveal" style="--d:0.04s">
          <span class="tag">03 / mcp</span>
          <h3>MCP first-class</h3>
          <p><span class="l-en">stdio, SSE, streamable HTTP. External servers merge their tools into one registry under a prefix.</span><span class="l-zh">stdio、SSE、streamable HTTP。外部服务器的工具以前缀合并进同一 registry。</span></p>
        </div>
        <div class="feat reveal" style="--d:0.1s">
          <span class="tag">04 / plan + sandbox</span>
          <h3><span class="l-en">Plan mode &amp; sandbox</span><span class="l-zh">计划模式 + 沙箱</span></h3>
          <p><span class="l-en">Writers are jailed to the workspace; <code>/plan</code> gates the session read-only until you approve.</span><span class="l-zh">写工具被关进工作区;<code>/plan</code> 进只读门,批准前不写盘。</span></p>
          <code class="feat-chip">$ /plan → read-only until approved</code>
        </div>
        <div class="feat reveal" style="--d:0.06s">
          <span class="tag">05 / subagents</span>
          <h3><span class="l-en">Subagents &amp; skills</span><span class="l-zh">subagent 与 Skill</span></h3>
          <p><span class="l-en">explore / research / review / security-review agents, plus Markdown skill scripts with isolated tools.</span><span class="l-zh">explore / research / review / security-review subagent，加 Markdown Skill 脚本与隔离工具。</span></p>
        </div>
        <div class="feat reveal" style="--d:0.1s">
          <span class="tag">06 / terminal</span>
          <h3><span class="l-en">Terminal-native</span><span class="l-zh">终端原生</span></h3>
          <p><span class="l-en">Not another IDE plugin. <code>git diff</code> handles diffs, <code>ls</code> handles trees — the terminal is the workspace.</span><span class="l-zh">不是又一个 IDE 插件。diff 交给 <code>git diff</code>,树交给 <code>ls</code> —— 终端就是工作面板。</span></p>
          <code class="feat-chip">$ ssh build-box → orca code</code>
        </div>
      </div>
    </div>
  </section>

  <div class="divider" aria-hidden="true"><span class="line"></span></div>

  <section id="how">
    <div class="how-track">
      <div class="how-stage">
        <div class="wrap">
          <div class="sec-head center reveal">
            <span class="kicker"><span class="l-en">How it works</span><span class="l-zh">工作原理</span></span>
            <h2><span class="l-en">Every turn reuses <span class="em">the last.</span></span><span class="l-zh">每一轮都复用<span class="em">上一轮。</span></span></h2>
            <p><span class="l-en">Each request replays the exact same byte-for-byte prefix, so the model only computes what's new. Long sessions get cheaper per turn — not more expensive.</span><span class="l-zh">每次请求都逐字节重放完全相同的前缀,模型只计算新增部分。会话越长,每轮越便宜——而不是越贵。</span></p>
          </div>
          <div class="cache-panel reveal">
            <div class="cache-grid">
              <div class="cache-steps">
                <span class="cap" data-step="1"><span class="n">01</span><span class="l-en">Cold start — everything is computed</span><span class="l-zh">冷启动——全部需要计算</span></span>
                <span class="cap" data-step="2"><span class="n">02</span><span class="l-en">The previous turn replays from cache</span><span class="l-zh">上一轮全部从缓存重放</span></span>
                <span class="cap" data-step="3"><span class="n">03</span><span class="l-en">Only the new request is computed</span><span class="l-zh">只计算新增的请求</span></span>
                <span class="cap" data-step="4"><span class="n">04</span><span class="l-en">90%+ cache hit — cheaper every turn</span><span class="l-zh">命中 90%+——越跑越便宜</span></span>
              </div>
              <div class="cache-rows-wrap">
                <div class="cache-row"><span class="lbl">turn 1</span><span class="blk new"></span><span class="blk new"></span><span class="blk new"></span></div>
                <div class="cache-row"><span class="lbl">turn 2</span><span class="blk hit"></span><span class="blk hit"></span><span class="blk hit"></span><span class="blk new"></span><span class="blk new"></span></div>
                <div class="cache-row"><span class="lbl">turn 3</span><span class="blk hit"></span><span class="blk hit"></span><span class="blk hit"></span><span class="blk hit"></span><span class="blk hit"></span><span class="blk new"></span><span class="blk new"></span><span class="blk new"></span></div>
                <div class="cache-row"><span class="lbl">turn 4</span><span class="blk hit"></span><span class="blk hit"></span><span class="blk hit"></span><span class="blk hit"></span><span class="blk hit"></span><span class="blk hit"></span><span class="blk hit"></span><span class="blk hit"></span><span class="blk new"></span><span class="blk new"></span></div>
                <div class="cache-legend">
                  <span><i style="background: var(--accent);"></i><span class="l-en">new tokens — computed</span><span class="l-zh">新 token——需要计算</span></span>
                  <span><i style="background: color-mix(in oklch, var(--accent) 12%, transparent); border: 1px solid color-mix(in oklch, var(--accent) 40%, transparent);"></i><span class="l-en">cached prefix — replayed, billed at ~1/5</span><span class="l-zh">缓存前缀——重放,约 1/5 计费</span></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider" aria-hidden="true"><span class="line"></span></div>

  <section>
    <div class="wrap">
      <div class="steps">
        <div class="step reveal">
          <span class="num">01</span>
          <h3><span class="l-en">Install</span><span class="l-zh">安装</span></h3>
          <p><span class="l-en">One command. macOS, Linux, Windows, and WSL.</span><span class="l-zh">一条命令,支持 macOS、Linux、Windows 与 WSL。</span></p>
          <code>npm i -g orca-agent</code>
        </div>
        <div class="step reveal" style="--d:0.08s">
          <span class="num">02</span>
          <h3><span class="l-en">Point it at a repo</span><span class="l-zh">指向你的仓库</span></h3>
          <p><span class="l-en">O.R.C.A maps the codebase once, then keeps that map in the warm prefix.</span><span class="l-zh">O.R.C.A 只做一次代码库测绘,然后把这份地图常驻在温热的前缀缓存里。</span></p>
          <code>cd your-project &amp;&amp; orca code</code>
        </div>
        <div class="step reveal" style="--d:0.16s">
          <span class="num">03</span>
          <h3><span class="l-en">Leave it running</span><span class="l-zh">让它一直跑着</span></h3>
          <p><span class="l-en">Queue tasks, review diffs, resume anytime. The session never goes cold.</span><span class="l-zh">排任务、看 diff、随时恢复。会话永不冷却。</span></p>
          <code>› refactor the auth flow</code>
        </div>
      </div>
    </div>
  </section>

  <div class="divider" aria-hidden="true"><span class="line"></span></div>

  <section id="community">
    <div class="wrap">
      <div class="sec-head split reveal">
        <span class="kicker"><span class="l-en">Community</span><span class="l-zh">社区共建</span></span>
        <h2><span class="l-en">Built in the open, with <span class="em">{community.contributors} contributors.</span></span><span class="l-zh">开源共建,感谢 <span class="em">{community.contributors} 位贡献者。</span></span></h2>
        <p><span class="l-en">O.R.C.A is MIT-licensed and developed in public. Every issue, every PR, every late-night review made it what it is — thank you.</span><span class="l-zh">O.R.C.A 采用 MIT 许可,开放开发。每一个 issue、每一条 PR、每一次深夜 review,成就了今天的它——谢谢你们。</span></p>
      </div>
    </div>
    <div class="crew reveal" aria-hidden="false">
      <div class="crew-row">
        <span class="crew-set">
          {rowA.map((c, i) => (
            <a class={avClass(i)} data-h={`@${c.login}`} href={c.url} target="_blank" rel="noreferrer" aria-label={c.login}>
              <img src={c.avatar} alt={c.login} loading="lazy" width="60" height="60" />
            </a>
          ))}
        </span>
      </div>
      <div class="crew-row rev">
        <span class="crew-set">
          {rowB.map((c, i) => (
            <a class={avClass(i + 3)} data-h={`@${c.login}`} href={c.url} target="_blank" rel="noreferrer" aria-label={c.login}>
              <img src={c.avatar} alt={c.login} loading="lazy" width="60" height="60" />
            </a>
          ))}
          <a class="av you" data-h="this could be you · 虚位以待" href={`${repo}/issues`} target="_blank" rel="noreferrer">+</a>
        </span>
      </div>
    </div>
    <div class="wrap">
      <div class="crew-cta reveal">
        <a class="btn btn-dark" href={repo}><span class="l-en">Contribute on GitHub</span><span class="l-zh">在 GitHub 上参与贡献</span></a>
        <a class="btn btn-ghost" href={`${repo}/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22`}><span class="l-en">Good first issues →</span><span class="l-zh">新手友好任务 →</span></a>
      </div>
      <div class="crew-note reveal"><span class="l-en">{fmtN(community.stars)} stars · {fmtN(community.mergedPrs)} merged PRs · every avatar above is a real contributor</span><span class="l-zh">{fmtN(community.stars)} stars · {fmtN(community.mergedPrs)} 个已合并 PR · 上面每个头像都是一位真实贡献者</span></div>
    </div>
  </section>

  <section class="cta" id="start">
    <h2 class="reveal"><span class="l-en">Start a session that <span class="em">lasts.</span></span><span class="l-zh">开启一场<span class="em">不会中断</span>的会话。</span></h2>
    <p class="reveal" style="--d:0.08s"><span class="l-en">Open source under MIT. Bring a provider key or run a local model; you choose where model requests are processed.</span><span class="l-zh">MIT 开源。使用自己的供应商密钥或本地模型，由你决定模型请求在哪里处理。</span></p>

    <div class="dl reveal" style="--d:0.14s">
      <div class="dl-tabs" role="tablist">
        <button class="dl-tab active" type="button" data-pane="npm" role="tab">npm</button>
        <button class="dl-tab" type="button" data-pane="brew" role="tab">Homebrew</button>
        <button class="dl-tab" type="button" data-pane="desktop" role="tab"><span class="l-en">Desktop</span><span class="l-zh">桌面端</span></button>
      </div>

      <div class="dl-pane active" data-pane="npm">
        <span class="install"><span class="ps1">$</span>npm i -g orca-agent<button data-copy="npm i -g orca-agent">Copy</button></span>
        <div class="chan">
          <div class="chan-row rec">
            <code>npm i -g orca-agent</code><span class="v">v<span class="rxv">{goVer}</span></span>
            <span class="s"><span class="l-en">Go rewrite · one binary · no Node · actively developed</span><span class="l-zh">Go 重写 · 单二进制 · 无需 Node · 主力开发中</span></span>
            <span class="chan-badge"><span class="l-en">recommended</span><span class="l-zh">推荐</span></span>
          </div>
          <div class="chan-row">
            <code>npm i -g orca-agent</code><span class="v">v<span class="rxv">{goVer}</span></span>
            <span class="s"><span class="l-en">deprecated 0.x line · no longer maintained</span><span class="l-zh">已废弃的 0.x 线 · 不再维护</span></span>
            <span class="chan-badge pre"><span class="l-en">deprecated</span><span class="l-zh">已废弃</span></span>
          </div>
        </div>
        <div class="dl-note"><span class="l-en">macOS / Linux / Windows / WSL · the <span class="mono">latest</span> tag is pinned at v0.53 — always install from <span class="mono">@next</span> · <a class="rxnotes" href={`${repo}/releases/tag/v${goVer}`}>v<span class="rxv">{goVer}</span> release notes →</a></span><span class="l-zh">macOS / Linux / Windows / WSL · <span class="mono">latest</span> 标签固定在 v0.53——请始终通过 <span class="mono">@next</span> 安装 · <a class="rxnotes" href={`${repo}/releases/tag/v${goVer}`}>v<span class="rxv">{goVer}</span> 更新说明 →</a></span></div>
      </div>

      <div class="dl-pane" data-pane="brew">
        <span class="install"><span class="ps1">$</span>brew install nanbo0ne/O.R.C.A-for-Windows/orca-agent<button data-copy="brew install nanbo0ne/O.R.C.A-for-Windows/orca-agent">Copy</button></span>
        <div class="dl-note"><span class="l-en">v<span class="rxv">{goVer}</span> (Go rewrite) · macOS &amp; Linux · update with <span class="mono">brew upgrade</span></span><span class="l-zh">v<span class="rxv">{goVer}</span>(Go 重写)· macOS 与 Linux · 通过 <span class="mono">brew upgrade</span> 更新</span></div>
      </div>

      <div class="dl-pane" data-pane="desktop">
        <div class="os-grid">
          <div class="os-card" data-os="mac">
            <h4>macOS</h4>
            <span class="meta">.dmg · universal (Apple Silicon &amp; Intel)</span>
            <a class="btn btn-light" href={`${R2}/O.R.C.A-macos-universal.dmg`} download><span class="l-en">Download · v<span class="rxv">{goVer}</span></span><span class="l-zh">下载 · v<span class="rxv">{goVer}</span></span></a>
          </div>
          <div class="os-card" data-os="win">
            <h4>Windows</h4>
            <span class="meta">.exe installer · x64 · Windows 10+</span>
            <a class="btn btn-light" href={`${R2}/O.R.C.A-for-Windows-windows-amd64-installer.exe`} download><span class="l-en">Download · v<span class="rxv">{goVer}</span></span><span class="l-zh">下载 · v<span class="rxv">{goVer}</span></span></a>
          </div>
          <div class="os-card" data-os="linux">
            <h4>Linux</h4>
            <span class="meta">.tar.gz · amd64</span>
